      "i": 0,
      "t0": 0,
      "t1": 10.64,
      "text": "एक पूरी तरह से विकसित एथलीट की तरह बाघ चढ़ाई कर सकता है।   हालांकि अच्छी तरह से नहीं तैर सकता है"
     },
     {
      "i": 1,
      "t0": 10.64,
      "t1": 30,
      "text": "बड़ी दूरी तक छलंग लगा सकता है और एक शक्तिशाली मनुष्य के पांच गुना बल के साथ खींच सकता है।   हून ने इस्तफा दे दिया है मंत्रिमंडल में उनकी जगह सांसद एड डेवी लेंगे"
     },
     {
      "i": 2,
      "t0": 30,
      "t1": 47.6,
      "text": "सांसद नर्मन लैम के व्यापार मंत्री बनने की उम्मीद है यहां पद डेवी के मंत्रिमंडल में जाने की बजाय खाली हुई है।   यह सिद्धांत देखते हैं कि कुछ लोगों के बारे में।"
     },
     {
      "i": 3,
      "t0": 47.6,
      "t1": 60,
      "text": "ऐसी कौन सी बातें हैं जो उन्हें वही चीज करने के लिए कहती है वह वे चाहते हैं और उनके माहौल को"
     }
