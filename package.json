{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "description": "Forward the family voice notes: NVIDIA ASR and NanoCodec on Nebius Serverless AI Jobs keep each voice as codec tokens with a searchable Hindi transcript, and every promise in it becomes a reminder quoted word for word.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:worker": "python3 -m pytest -q worker scripts",
    "e2e": "playwright test",
    "embed-worker": "node scripts/embed-worker.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run audit"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
