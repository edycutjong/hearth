# Copy to .env.local. Every value is a placeholder. The app runs without any of it: a cold visit
# shows /judge and /proof from recorded evidence; only keeping a NEW note needs the Nebius block.

# ── Nebius service account (Serverless AI Jobs REST + Object Storage) ──
NEBIUS_SERVICE_ACCOUNT_ID=
NEBIUS_AUTH_KEY_ID=
NEBIUS_AUTH_PRIVATE_KEY=          # PEM, single line with \n escapes
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=
NEBIUS_REGION=eu-west1
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
HEARTH_BUCKET=hearth-data

# ── Token Factory (memory extraction: nvidia/nemotron-3-super-120b-a12b) ──
TOKENFACTORY_API_KEY=

# ── App ──
HEARTH_SPACE_SECRET=              # HMAC secret for space keys; any long random string
HEARTH_JUDGE_CODE=                # optional: lets a judge bypass the daily new-keep cap
HEARTH_PUBLIC_URL=http://localhost:3000
CRON_SECRET=                      # optional: protects /api/cron/sweep

# ── Privacy flags (default false: per-space opt-in shows the default-retention sentence) ──
TF_ZDR_ON=false
TF_ZDR_CONFIRMED=false
